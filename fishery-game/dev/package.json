{
  "name": "umikaze-fishery-dev-tests",
  "private": true,
  "type": "module",
  "description": "自動テスト用（CI）。ゲーム本体には含まれません。",
  "scripts": {
    "build": "node build-dev.mjs",
    "check-prod": "node check-prod.mjs",
    "qa": "node qa.mjs",
    "monkey": "node monkey.mjs --steps 300 --seeds 2",
    "i18n": "node i18n.mjs check",
    "order": "node check-order.mjs",
    "leak": "node i18n-leak.mjs --days 30",
    "monkey-en": "node monkey.mjs --lang en --steps 300 --seeds 2"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5"
  }
}
